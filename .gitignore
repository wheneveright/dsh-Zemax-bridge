Zemax/config.json
config.json
*.bak

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Editor / OS
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# 大体积中间产物（Zemax 射线数据库 / 光束文件等，可达 GB 级）
*.zrd
*.zbf
*.ZRD
*.ZBF
